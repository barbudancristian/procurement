<Window x:Class="SourcingHub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sourcing Hub" Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" />
        <TextBlock x:Name="Status" Text="Starting Sourcing Hub…" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="560" FontSize="14" TextAlignment="Center" />
    </Grid>
</Window>
